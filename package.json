{
  "name": "saidao-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "eslint . && tsc --noEmit && prettier --check \"src/**/*.{ts,tsx,css}\"",
    "fix": "eslint . --fix && prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-viewer": "^3.2.6",
    "@heroui/react": "^3.0.0",
    "@heroui/styles": "^3.0.0",
    "tailwind-variants": "^3.0.0",
    "zustand": "^5.0.0",
    "swr": "^2.0.0",
    "axios": "^1.7.0",
    "lodash-es": "^4.17.21",
    "dayjs": "^1.11.0",
    "qs": "^6.12.0",
    "zod": "^3.25.0",
    "reconnecting-websocket": "^4.4.0",
    "@fingerprintjs/fingerprintjs": "^4.6.0",
    "xgplayer": "^3.0.26",
    "xgplayer-hls": "^3.0.26",
    "xgplayer-flv": "^3.0.26",
    "xgplayer-mp4": "^3.0.26",
    "hls.js": "^1.5.0",
    "mpegts.js": "^1.8.0",
    "lucide-react": "^0.400.0",
    "workbox-window": "^7.1.0",
    "workbox-core": "^7.1.0",
    "workbox-precaching": "^7.1.0",
    "workbox-routing": "^7.1.0",
    "workbox-strategies": "^7.1.0",
    "workbox-expiration": "^7.1.0",
    "workbox-cacheable-response": "^7.1.0",
    "virtua": "^0.40.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-config-prettier": "^10.0.0",
    "@eslint/eslintrc": "^3.0.0",
    "@eslint/js": "^9.0.0",
    "prettier": "^3.3.0",
    "@types/lodash-es": "^4.17.12",
    "@types/qs": "^6.9.15",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "vitest": "^2.0.0",
    "jsdom": "^25.0.0"
  }
